# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/

# --- Organizer catalog (read-only, never redistributed) ---
# Download catalog.jsonl.gz from the participant-kit release and extract it as
# data/catalog.jsonl; see README "Setup". The 50,000-row catalog and its archive
# stay out of this repository under the source dataset's terms.
data/catalog.jsonl
data/catalog.jsonl.gz
/catalog.jsonl
catalog.jsonl.gz
*.jsonl.gz

# --- Generated artifacts ---
# Per-session evaluator dumps, regenerated by the tools in tools/. Only the
# compact results/*_metrics.json summaries are committed as evidence.
results/*_full.json
# Ad-hoc development sweeps that no doc, tool, or demo bundle references.
results/for_test_*
# Nothing in the demo, the README, or the tests reads these, so they stay local:
# proxy sweeps over non-public targets, the output-risk calibration, the
# layer/decision A/Bs, the stress-case corpus, and the paired upgrade bootstrap.
results/tail_exploration_*
results/question_policy_matched_ab.json
results/question_policy_uniform_ab.json
results/risk_gate_calibration.json
results/stress_cases.json
results/structured_ab_metrics.json
results/decision_ab_metrics.json
results/question_policy_ab_metrics.json
results/upgrade_ab_metrics.json
# Static demo export rebuilt by tools/build_static_site.py and by CI.
site/

# --- Secrets and local environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Local agent/editor helpers (not part of the submission) ---
CLAUDE.md
.claude/settings.local.json

# --- docs/: working material stays local ---
# Planning notes, rehearsal scripts, the Devpost story and judge material (which
# live on the Devpost entry itself), and the organizer's participant-kit
# documents. README.md is the published narrative.
# docs/baseline_results.json stays tracked: the demo bundle manifest hashes it.
docs/*.md
docs/*.py
docs/evaluation_config.json
docs/agent_api_contract.json
docs/finals_research

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Benchmark run logs are scratch output; the JSON summaries are tracked.
results/logs/

# Competitor research for the Grand Final playbook stays local.
results/track4_devpost_projects.json

# Cross-category catalogs built by tools/build_category_catalog.py stay local
# under the source dataset terms; results/cross_category/summary.* is tracked.
data/catalog_*.jsonl
data/catalog_*.summary.json
results/cross_category/*_full.json
results/cross_category/logs/


# paper
paper/

# --- Grand Final research artifacts -------------------------------------
# The attribution grid, the dense arms and the cross-category runs produce
# ~270 MB of per-session traces, grounding caches and embedding matrices.
# Only the citable roll-ups (summary.json / summary.md / intervals.md) are
# tracked; regenerate the rest with tools/run_attribution.py,
# tools/cross_category.py and tools/build_mixed_catalog.py.
results/attribution/**
!results/attribution/**/
!results/attribution/**/summary.json
!results/attribution/**/summary.md
!results/attribution/**/intervals.md

results/dense/
results/rewrites_gemma.json

results/cross_category/**
!results/cross_category/**/
!results/cross_category/summary.json
!results/cross_category/summary.md

# Department maps derived from the mixed catalogs stay local with them.
data/catalog_*.departments.json
